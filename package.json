{
  "name": "diary-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @diary/client",
    "build": "npm run build --workspace @diary/client",
    "build:mobile": "npm run build:mobile --workspace @diary/client",
    "mobile:assets": "node scripts/generate-mobile-assets.mjs",
    "mobile:sync": "npm run mobile:assets && npm run build:mobile && npm run sync --workspace @diary/mobile",
    "mobile:android": "npm run mobile:sync && npm run android:debug --workspace @diary/mobile",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "learn:04": "vite learning/lesson-04 --host 127.0.0.1 --port 4180 --strictPort",
    "check:learn:04": "node scripts/check-lesson-04.mjs",
    "learn:05": "vite learning/lesson-05 --host 127.0.0.1 --port 4181 --strictPort",
    "check:learn:05": "node scripts/check-lesson-05.mjs",
    "learn:06": "vite learning/lesson-06 --host 127.0.0.1 --port 4182 --strictPort",
    "check:learn:06": "node scripts/check-lesson-06.mjs",
    "learn:07": "vite learning/lesson-07 --host 127.0.0.1 --port 4183 --strictPort",
    "check:learn:07": "node scripts/check-lesson-07.mjs",
    "learn:08": "vite learning/lesson-08 --host 127.0.0.1 --port 4184 --strictPort",
    "check:learn:08": "node scripts/check-lesson-08.mjs",
    "learn:09": "node learning/lesson-09/server.mjs",
    "check:learn:09": "node scripts/check-lesson-09.mjs",
    "learn:10": "node learning/lesson-10/server.mjs",
    "check:learn:10": "node scripts/check-lesson-10.mjs",
    "learn:11": "node learning/lesson-11/server.mjs",
    "check:learn:11": "node scripts/check-lesson-11.mjs",
    "learn:12": "node learning/lesson-12/server.mjs",
    "check:learn:12": "node scripts/check-lesson-12.mjs",
    "learn:13": "node learning/lesson-13/server.mjs",
    "check:learn:13": "node scripts/check-lesson-13.mjs",
    "learn:14": "node learning/lesson-14/server.mjs",
    "check:learn:14": "node scripts/check-lesson-14.mjs",
    "learn:15": "node learning/lesson-15/server.mjs",
    "check:learn:15": "node scripts/check-lesson-15.mjs",
    "learn:16": "node learning/lesson-16/server.mjs",
    "check:learn:16": "node scripts/check-lesson-16.mjs",
    "check:learn:all": "node scripts/check-learning-curriculum.mjs",
    "preview": "npm run preview --workspace @diary/client",
    "preview:mobile": "npm run preview:mobile --workspace @diary/client",
    "dev:api": "npm run dev --workspace @diary/api",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run migrate --workspace @diary/api",
    "db:restore-drill": "node scripts/backup-restore-drill.mjs",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.js",
    "test:auth-browser": "playwright test --config playwright.auth.config.js",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "fake-indexeddb": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
